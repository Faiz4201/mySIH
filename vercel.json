{
    "rewrites": [
        {
            "source": "/api/sarvam/:path*",
            "destination": "https://api.sarvam.ai/:path*"
        },
        {
            "source": "/api/translate/:path*",
            "destination": "https://translate.googleapis.com/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}